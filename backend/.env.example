PORT=3000
# SQLite en local ; sur Vercel, l'intégration Neon fournit POSTGRES_URL automatiquement.
DATABASE_URL=./data.sqlite
SESSION_SECRET=change-me-with-a-long-random-value
FRONTEND_URL=http://localhost:5173
PICTURES_DIR=./Pictures
# Stockage S3 (Cloudflare R2, Backblaze B2…). Sans S3_BUCKET, les photos vont dans PICTURES_DIR.
# Obligatoire sur Vercel : le disque des fonctions est éphémère.
# S3_ENDPOINT=https://<id-de-compte>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=photo-platform
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
TRUST_PROXY=false
